# ==============================================================================
# BACKEND ENVIRONMENT TEMPLATE (FastAPI & Services)
# ==============================================================================

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@host.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# AWS Credentials (AWS S3 & Bedrock)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_S3_BUCKET_NAME=record-xlsx

# Application Server Settings
ENVIRONMENT=development
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
