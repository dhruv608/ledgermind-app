# LedgerMind server settings for the live server. Copy to backend/.env.production on the server and fill in.
# Never commit the filled-in file.

ENVIRONMENT=production

# The app's web address (no slash at the end)
ALLOWED_ORIGINS=https://ledgermind.duckdns.org

# Sign-in cookie: https only on the internet
SESSION_DAYS=7
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# Neon database in London (the connection string from the Neon 'ledgermind' project)
DATABASE_URL=

# Files and AI in London. Leave the two AWS keys EMPTY on the server: it uses the server's own AWS role instead
AWS_REGION=eu-west-2
BEDROCK_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=ledgermind-files-london
FILE_STORAGE=s3

# Companies House (a key registered to the firm)
COMPANIES_HOUSE_API_KEY=
